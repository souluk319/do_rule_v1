# ============================================
# DO-RULE 환경 변수 예시
# 이 파일을 복사하여 .env 로 저장하세요.
# ============================================

# ── AI 연동 설정 ──────────────────────────────
# true 로 설정하면 Ollama LLM으로 동적 단어 생성
# false (기본값) 이면 폴백 단어 풀만 사용 → AI 없이도 게임 완전 동작
VITE_AI_ENABLED=false

# Ollama API 엔드포인트
VITE_OLLAMA_URL=http://localhost:11434/api/generate

# 사용할 모델명 (예: eeve, qwen3:4b, gemma2:2b, llama3.2)
VITE_OLLAMA_MODEL=eeve

# API 응답 타임아웃 (밀리초). 초과 시 폴백 단어 사용
VITE_OLLAMA_TIMEOUT_MS=5000
